# RepoHawk Backend — Environment Variables Template
# Copy this to .env and fill in your values for production.
# WARNING: .env contains secrets — never commit to git (it's in .gitignore).

# ── PostgreSQL ───────────────────────────────────────────────────────────────────
# DigitalOcean Managed Database connection string:
#DATABASE_URL=postgresql://repohawk_user:YOUR_PASSWORD@db-host-do-user-12345-0.b.db.ondigitalocean.com:25060/repohawk_db?sslmode=require
#
# Or compose from individual env vars (both forms work):
DATABASE_URL=postgresql://repohawk_user:repohawk_password@localhost:5432/repohawk_db

# ── OpenRouter (LLM provider) ───────────────────────────────────────────────────
# Get a free API key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-YOUR_KEY_HERE
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Model selection (OpenRouter free-tier models) ───────────────────────────────
# NOTE: Only models that return "content" work — avoid reasoning-only models.
MODEL_CHAT=nvidia/nemotron-3-nano-30b-a3b:free
MODEL_DIAGRAM=openai/gpt-oss-120b:free
MODEL_CRITIQUE=openai/gpt-oss-120b:free
MODEL_FALLBACK=nvidia/nemotron-3-nano-30b-a3b:free
MODEL_REWRITE=nvidia/nemotron-3-nano-30b-a3b:free

# ── Auth ─────────────────────────────────────────────────────────────────────────
# Generate a strong secret: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Email (Resend) ──────────────────────────────────────────────────────────────
RESEND_API_KEY=re_YOUR_KEY
RESEND_WELCOME_TEMPLATE_ID=
RESEND_PASSWORD_RESET_TEMPLATE_ID=

# ── Frontend ────────────────────────────────────────────────────────────────────
# Your Vercel deployment URL (or localhost for dev)
FRONTEND_URL=http://localhost:3000